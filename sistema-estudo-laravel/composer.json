{
    "name": "paulo/sistema-estudo-laravel",
    "type": "project",
    "description": "Projeto de estudo: rotas, Eloquent, API REST, MySQL e log em MongoDB",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0",
        "mongodb/laravel-mongodb": "^5.0"
    },
    "require-dev": {
        "laravel/tinker": "^2.9"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
